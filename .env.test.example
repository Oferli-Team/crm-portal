# Copy to .env.test to point the test suite at a local Supabase stack (or a
# dedicated test project) instead of whatever .env is configured for local
# dev — see test/support/env.ts. Never point this at a production project.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# From `supabase start`'s own output — fixed, publicly-documented local dev
# values, not real secrets.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# The app instance the E2E suite drives — a local `next start`, not a
# deployed Preview URL (see Stage 1's design).
TEST_APP_URL="http://localhost:3000"

# Every fixture email lives on this domain — never a real inbox.
TEST_EMAIL_DOMAIN="test.local"
