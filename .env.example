# Copy this file to .env and fill in real values from your Supabase project.

# Project Settings > Database > Connection string (Transaction pooler, port 6543)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Same page, Session pooler (port 5432) — used by the Prisma CLI only
# (migrate, db seed, validate). See prisma.config.ts.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Project Settings > API (keep secret). Needed to run `npm run db:seed`, and
# now also required at runtime for File Attachments (Supabase Storage
# uploads/downloads/deletes go through a service-role admin client — see
# src/lib/storage/admin-client.ts). Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# resend.com → API Keys (keep secret). Used server-side only, to send
# invitation emails. If unset, invites/resends still work — the app falls
# back to "created, but the email could not be sent" and the Copy link
# button, it just never calls Resend.
RESEND_API_KEY="your-resend-api-key"

# The "From" address for invitation emails. Must be on a domain verified in
# your Resend account (resend.com/domains) — unverified domains will be
# rejected by Resend at send time.
INVITATION_FROM_EMAIL="Client Portal CRM <invites@yourdomain.com>"

# Server-only base URL used to build the /invite/{token} link inside
# invitation emails — deliberately NOT NEXT_PUBLIC_ (never read on the
# client, never built from a request's Host header). No trailing slash.
# Optional on Vercel: falls back to `https://${VERCEL_URL}` (set
# automatically for every deployment) if omitted, and to
# http://localhost:3000 in local dev.
APP_BASE_URL="https://your-production-domain.com"

# Server-only secret required by every /api/cron/* route (notification
# delivery retry, notification cleanup) — deliberately NOT NEXT_PUBLIC_.
# Vercel Cron sends this back as `Authorization: Bearer <value>` on every
# scheduled invocation (see vercel.json's `crons` and Vercel's own docs on
# securing Cron Jobs). Generate a long random value, e.g.:
#   openssl rand -base64 32
# Without this set, every cron route rejects all requests with 401 — there
# is no "unauthenticated but still works" fallback.
CRON_SECRET="a-long-random-value-never-committed"

# ---------------------------------------------------------------------------
# Platform branding (see src/lib/legal/platform-config.ts's getPlatformBranding())
# — the product's own visual identity, white-label friendly (Sale-Ready
# Phase D, D2). PLATFORM_NAME is the primary "what is this platform
# called" source; PLATFORM_LEGAL_NAME below falls back to it (never a
# second, independent name). All optional — fall back to the existing
# hardcoded src/config/site.ts defaults (name/description) if unset, or
# to null (rendered as "Not set", never fabricated) for the two URLs.
PLATFORM_NAME=""
PLATFORM_TAGLINE=""
PLATFORM_LOGO_URL=""
PLATFORM_FAVICON_URL=""

# ---------------------------------------------------------------------------
# Platform Configuration — Email (see src/lib/legal/platform-config.ts's
# getPlatformEmailConfig(), Sale-Ready Phase D, D3). Read-only status of the
# platform's outbound email setup for the Platform Configuration page — never
# used to actually send anything. RESEND_API_KEY and INVITATION_FROM_EMAIL
# above already do the real sending; this just reflects whether they're set.
# Both variables below are new and optional. PLATFORM_BILLING_EMAIL has no
# fallback (a real, distinct mailbox or "Not set" — never borrowed from
# support). PLATFORM_REPLY_TO_EMAIL falls back to INVITATION_FROM_EMAIL's
# address when unset (not read by any actual send yet — display-only, like
# PLATFORM_FAVICON_URL).
PLATFORM_BILLING_EMAIL=""
PLATFORM_REPLY_TO_EMAIL=""

# ---------------------------------------------------------------------------
# Platform legal configuration (see src/lib/legal/platform-config.ts) —
# describes the ONE operator running this Service for every tenant. This is
# deliberately separate from a customer's own Business Identity
# (OrganizationProfile): it feeds the /privacy and /terms pages, the site
# footer, and the footer of every transactional email. All optional — each
# has a safe, honest fallback (never a fabricated address or mailbox) if
# left unset, but a real production deployment should set all six.
PLATFORM_LEGAL_NAME="Client Portal CRM"
PLATFORM_LEGAL_ADDRESS=""
PLATFORM_SUPPORT_EMAIL=""
PLATFORM_JURISDICTION=""
PRIVACY_POLICY_EFFECTIVE_DATE="August 9, 2026"
TOS_EFFECTIVE_DATE="August 9, 2026"

# ---------------------------------------------------------------------------
# Platform Admin (see src/lib/platform-admin/authorization.ts) — a
# comma-separated allowlist of Supabase auth emails permitted to read the
# internal, read-only /platform-admin/* tools (Sale-Ready Phase C). This is
# a SaaS-operator concern, deliberately not a Role/Membership: it grants
# access across every organization, not any one tenant's own workspace.
# Unset (the default) means nobody has access — every request redirects
# away, never a visible "access denied." Matching case-insensitively.
PLATFORM_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Billing (Paddle) — read and validated by a small config module
# (src/lib/billing/provider/paddle-config.ts), and actively used by the
# provider registry (getBillingProviderAdapter(), src/lib/billing/
# provider/provider.ts). See docs/billing-provider-adapter.md for the
# full setup guide and env-var reference.
#
# Current behavior (Sale-Ready Phase E, E2.6):
#   - Setting every one of the six variables below to a real, valid
#     value activates the real Paddle adapter (real checkout, real
#     Customer Portal, real signature-verified webhook processing) —
#     no application code changes required.
#   - Any single variable missing, empty, whitespace-only, or invalid
#     (e.g. an unrecognized BILLING_ENVIRONMENT, or BILLING_PROVIDER not
#     exactly "PADDLE") fails closed to the same safe "not configured"
#     state as leaving all six unset — never a partially-configured
#     adapter.
#   - TEST_MODE (this repo's own E2E test flag, never set in a real
#     deployment) always takes priority over a real Paddle config, even
#     if both happen to be present at once.
#
# All six below are server-only by design — never give any of these a
# NEXT_PUBLIC_ prefix (scripts/security-checks/check-billing-security.mjs
# fails the build if one ever does). No real key, secret, or price id
# belongs in this file or in any other committed file, ever.
BILLING_PROVIDER=
# Which Paddle mode these credentials are for — sandbox (safe for
# testing, no real money) or live (real payments). Only these two exact
# values are accepted; anything else is treated as unconfigured, never
# guessed.
BILLING_ENVIRONMENT=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_STARTER_PRICE_ID=
BILLING_PRO_PRICE_ID=

# Sale-Ready Phase E, E2.5 (Paddle Checkout UX / Hosted Checkout Bridge).
# This ONE variable is deliberately public/client-safe, unlike every
# other billing variable above — it is Paddle's own dedicated
# "client-side token" (created and managed in Paddle > Developer tools >
# Authentication in the Paddle dashboard), explicitly documented by
# Paddle as safe for a browser bundle. It is NOT the same credential as
# BILLING_API_KEY (which stays server-only, used only by the Transactions
# API) and cannot be used to call any server-side Paddle API — it can
# only initialize Paddle.js in the browser to render a checkout overlay.
# scripts/security-checks/check-billing-security.mjs allowlists exactly
# this one NEXT_PUBLIC_ billing variable; every other billing variable
# (including any future one) stays banned with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_BILLING_CLIENT_TOKEN=
